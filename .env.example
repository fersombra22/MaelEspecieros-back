# ===================================================================
# CONFIGURACIÓN DE PRODUCCIÓN - MAEL ESPECIEROS
# ===================================================================
# Copie este archivo como .env o defina estas variables en su sistema operativo/servidor.

# Claves Criptográficas de Alta Seguridad (¡Nunca compartir ni subir a Git!)
JWT_SECRET=CambiarPorClaveHexadecimalOTextoMuyLargoYSeguro2026!
BLOCKCHAIN_SECRET=CambiarPorSecretoHmacUltraRobustoParaLaCadenaDeBloques2026!

# Configuración de Correo Electrónico (Para envío de comprobantes a clientes)
# Ejemplo con Gmail (requiere "Contraseña de aplicación" generada en cuenta Google):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_gmail
MAIL_FROM=ventas@maelespecieros.com

# Inteligencia Artificial (Google Gemini)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.6-flash

# Seguridad Web & Orígenes Permitidos
CORS_ALLOWED_ORIGIN=http://localhost:4200
